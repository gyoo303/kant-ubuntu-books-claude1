# 값은 비워 두고 .env.local에 채운다. (.env.local은 Git에 올라가지 않는다)

# Supabase 프로젝트 주소 (공개)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable(anon) 키, RLS 적용 (공개)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용: Cron, 결제 처리, 빌링키 접근 (비밀)
SUPABASE_SERVICE_ROLE_KEY=
# 마이그레이션 적용용 DB 연결 문자열 (비밀, npx supabase db push --db-url 에서만 사용)
SUPABASE_DB_URL=

# 토스페이먼츠 API 개별 연동 테스트 클라이언트 키 (공개)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 토스페이먼츠 테스트 시크릿 키 (비밀)
TOSS_SECRET_KEY=

# Vercel Cron 요청 확인용 임의 문자열 (비밀)
CRON_SECRET=

# OAuth·결제 리다이렉트 기준 주소 (예: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# 개발 전용 테스트 로그인. production 빌드에서는 값과 관계없이 꺼진다.
DEV_TEST_LOGIN=
# 테스트 계정 비밀번호를 만드는 데 쓰는 임의 문자열 (비밀)
DEV_TEST_LOGIN_SECRET=

# 네이버 로그인 (서버가 직접 처리, D-042). 네이버 개발자 센터 → 내 애플리케이션 → 개요
NAVER_CLIENT_ID=
# 네이버 Client Secret (비밀)
NAVER_CLIENT_SECRET=
